  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  },
  "overrides": {
    "next-themes": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort false --clearScreen false",
    "dev:localhost": "vite --host 127.0.0.1 --port 5173 --strictPort false --clearScreen false",
    "dev:dyad": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:raw": "vite build",
    "buid": "npm run build",
    "build:serve": "npm run build && npm run preview:local",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort false",
    "preview:local": "node scripts/preview-local.mjs",
    "test:e2e": "playwright test"
  },
